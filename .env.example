# Optional SpacetimeDB connection. The game already ships a local catalog seed.
NEXT_PUBLIC_SPACETIMEDB_HOST=
NEXT_PUBLIC_SPACETIMEDB_DB_NAME=last-bit-standing

# Grok Voice (xAI TTS). Without a key the table falls back to the browser voice.
XAI_API_KEY=
# Optional. Defaults to eve.
XAI_VOICE_ID=eve
